{{!
    @template mod_completionboard/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="completionboard">
    {{{intro}}}

    {{#canmark}}
        <div class="completionboard-card mt-4">
            <div class="completionboard-card-label">{{#str}}yourstatus, completionboard{{/str}}</div>

            <div class="completionboard-status {{statusclass}}">
                {{status}}
            </div>

            {{#iscompleted}}
                <div class="completionboard-meta">
                    {{#str}}completedat, completionboard{{/str}}: {{completedtime}}
                </div>
            {{/iscompleted}}

            {{#isvalidated}}
                <div class="completionboard-meta">
                    {{#str}}validatedat, completionboard{{/str}}: {{validatedtime}}
                </div>
            {{/isvalidated}}

            <div class="completionboard-actions mt-3">
                {{{actionhtml}}}
            </div>
        </div>
    {{/canmark}}

    {{#canviewreport}}
        <div class="mt-4">
            <a class="btn btn-secondary" href="{{reporturl}}">
                {{#str}}openreport, completionboard{{/str}}
            </a>
        </div>
    {{/canviewreport}}
</div>
